{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "dev-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= npx vite --port 5174 --strictPort"
      ],
      "port": 5174
    }
  ]
}